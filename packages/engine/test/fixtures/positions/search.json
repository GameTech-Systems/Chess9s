        "g2": { "piece": "rook", "side": "light", "moved": true },
        "h3": { "piece": "rook", "side": "light", "moved": true },
        "b4": { "piece": "rook", "side": "light", "moved": true },
        "i9": { "piece": "king", "side": "dark", "moved": true }
      },
      "expect": { "mates": true }
    },
    {
      "name": "a queen left undefended on the rook's rank is taken",
      "overrides": {},
      "turn": "light",
      "pieces": {
        "c1": { "piece": "king", "side": "light", "moved": true },
        "b7": { "piece": "rook", "side": "light", "moved": true },
        "g7": { "piece": "queen", "side": "dark", "moved": true },
        "i9": { "piece": "king", "side": "dark", "moved": true }
      },
      "expect": { "plays": "b7xg7" }
    },
    {
      "name": "sunMoon.capture = any-move-square: the Sun takes the Queen straight ahead",
      "overrides": { "sunMoon.capture": "any-move-square" },
      "turn": "light",
      "pieces": {
        "c1": { "piece": "king", "side": "light", "moved": true },
        "c6": { "piece": "sun", "side": "light", "moved": true },
        "c7": { "piece": "queen", "side": "dark", "moved": true },
        "i9": { "piece": "king", "side": "dark", "moved": true }
      },
      "expect": { "plays": "c6xc7" }
    },
    {
      "name": "sunMoon.capture = diagonal-only: the Sun cannot take straight ahead, so it does not try",
      "overrides": { "sunMoon.capture": "diagonal-only" },
      "turn": "light",
      "pieces": {
        "c1": { "piece": "king", "side": "light", "moved": true },
        "c6": { "piece": "sun", "side": "light", "moved": true },
        "c7": { "piece": "queen", "side": "dark", "moved": true },
        "i9": { "piece": "king", "side": "dark", "moved": true }
