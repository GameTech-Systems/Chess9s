{
  "description": "Square rules (stop and pass) and gateway parameters on the neutral fixture. Expected moves worked out by hand (S11).",
  "cases": [
    {
      "name": "guard may not stop on a gateway while gate.occupants is hopper-only",
      "players": 2,
      "side": "light",
      "pieces": { "h5": { "piece": "guard", "side": "light" } },
      "expected": ["h5-g4", "h5-g5", "h5-g6", "h5-h6", "h5-i4", "h5-i5", "h5-i6"]
    },
    {
      "name": "gate.occupants any lets the guard stop on a gateway",
      "players": 2,
      "overrides": { "gate.occupants": "any" },
      "side": "light",
      "pieces": { "h5": { "piece": "guard", "side": "light" } },
      "expected": ["h5-g4", "h5-g5", "h5-g6", "h5-h4", "h5-h6", "h5-i4", "h5-i5", "h5-i6"]
    },
    {
      "name": "guard range 2 may neither stop on nor pass the gateway by default",
      "players": 2,
      "overrides": { "guard.range": 2 },
      "side": "light",
      "pieces": { "h3": { "piece": "guard", "side": "light" } },
      "expected": [
        "h3-f1",
        "h3-f3",
        "h3-f5",
        "h3-g2",
        "h3-g3",
        "h3-g4",
        "h3-h1",
        "h3-h2",
        "h3-i2",
        "h3-i3",
        "h3-i4"
      ]
    },
    {
      "name": "stopping allowed, passing not: the ray ends on the gateway",
      "players": 2,
      "overrides": { "guard.range": 2, "gate.occupants": "any" },
      "side": "light",
      "pieces": { "h3": { "piece": "guard", "side": "light" } },
      "expected": [
        "h3-f1",
        "h3-f3",
        "h3-f5",
        "h3-g2",
        "h3-g3",
        "h3-g4",
        "h3-h1",
        "h3-h2",
        "h3-h4",
        "h3-i2",
        "h3-i3",
        "h3-i4"
      ]
    },
    {
      "name": "gate.passThrough with guard: passes the gateway without stopping on it",
      "players": 2,
      "overrides": { "guard.range": 2, "gate.passThrough": ["slider", "guard"] },
      "side": "light",
      "pieces": { "h3": { "piece": "guard", "side": "light" } },
      "expected": [
        "h3-f1",
        "h3-f3",
        "h3-f5",
        "h3-g2",
        "h3-g3",
        "h3-g4",
        "h3-h1",
        "h3-h2",
        "h3-h5",
        "h3-i2",
        "h3-i3",
        "h3-i4"
      ]
    },
    {
      "name": "gate.passThrough with guard and gate.occupants any: stops on and passes the gateway",
      "players": 2,
      "overrides": {
        "guard.range": 2,
        "gate.occupants": "any",
        "gate.passThrough": ["slider", "guard"]
      },
      "side": "light",
      "pieces": { "h3": { "piece": "guard", "side": "light" } },
      "expected": [
        "h3-f1",
        "h3-f3",
        "h3-f5",
        "h3-g2",
        "h3-g3",
        "h3-g4",
        "h3-h1",
        "h3-h2",
        "h3-h4",
        "h3-h5",
        "h3-i2",
        "h3-i3",
        "h3-i4"
      ]
    },
    {
      "name": "gate.passThrough empty: the slider is stopped by the gateway",
      "players": 2,
      "overrides": { "gate.passThrough": [] },
      "side": "light",
      "pieces": { "b4": { "piece": "slider", "side": "light" } },
      "expected": ["b4-a4", "b4-b1", "b4-b2", "b4-b3", "b4-b5"]
    },
    {
      "name": "gate.occupants any lets the slider stop on the gateway it passes",
      "players": 2,
      "overrides": { "gate.occupants": "any" },
      "side": "light",
      "pieces": { "b4": { "piece": "slider", "side": "light" } },
      "expected": ["b4-a4", "b4-b1", "b4-b2", "b4-b3", "b4-b5", "b4-b6", "b4-b7", "b4-b8", "b4-b9"]
    },
    {
      "name": "gate.occupants any lets the leaper land on gateways",
      "players": 2,
      "overrides": { "gate.occupants": "any" },
      "side": "light",
      "pieces": { "e5": { "piece": "leaper", "side": "light" } },
      "expected": ["e5-b4", "e5-b6", "e5-d2", "e5-d8", "e5-f2", "e5-f8", "e5-h4", "e5-h6"]
    },
    {
      "name": "gate.passThrough with leaper changes nothing: a leaper crosses no squares",
      "players": 2,
      "overrides": { "gate.passThrough": ["leaper"] },
      "side": "light",
      "pieces": { "e5": { "piece": "leaper", "side": "light" } },
      "expected": ["e5-b4", "e5-d2", "e5-d8", "e5-f2", "e5-f8", "e5-h6"]
    },
    {
      "name": "a jumping move is not stopped by a no-passing rule (decision 2026-10-19)",
      "players": 2,
      "overrides": { "guard.range": 2, "guard.canJump": true },
      "side": "light",
      "pieces": { "h3": { "piece": "guard", "side": "light" } },
      "expected": [
        "h3-f1",
        "h3-f3",
        "h3-f5",
        "h3-g2",
        "h3-g3",
        "h3-g4",
        "h3-h1",
        "h3-h2",
        "h3-h5",
        "h3-i2",
        "h3-i3",
        "h3-i4"
      ]
    }
  ]
}
