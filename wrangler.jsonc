// Cloudflare Workers with Static Assets (decision 0003, D15) and the rooms (S52, D18, D50): one
// Worker serves the app and the rooms on one origin. The built web app is served as static files,
// and unknown paths (such as /privacy) fall back to index.html; only /api/* runs the Worker script
// first (apps/worker), which keeps each room in a Room Durable Object (SQLite storage, as Workers
// Free requires).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chess9s",
  "main": "./apps/worker/src/index.ts",
  "compatibility_date": "2026-10-22",
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  // Per-address limits (K1, S95): rooms made, room sockets opened and room-info requests, a minute
  // each, keyed by the connecting address (apps/worker/src/index.ts, LIMITS). Cloudflare counts
  // them per location, so they are a ceiling for abuse, not an exact count.
  "ratelimits": [
    { "name": "ROOM_LIMIT", "namespace_id": "9501", "simple": { "limit": 10, "period": 60 } },
    { "name": "SOCKET_LIMIT", "namespace_id": "9502", "simple": { "limit": 30, "period": 60 } },
    { "name": "INFO_LIMIT", "namespace_id": "9503", "simple": { "limit": 60, "period": 60 } },
  ],
  // Pull-request builds run `wrangler preview`, which needs this block. Previews do not inherit
  // bindings: the Room binding is repeated here, and each Preview gets its own namespace of rooms.
  // The limits are repeated too, on their own namespaces, so a preview's counts stay apart.
  "previews": {
    "durable_objects": {
      "bindings": [{ "name": "ROOMS", "class_name": "Room" }],
    },
    "ratelimits": [
      { "name": "ROOM_LIMIT", "namespace_id": "9511", "simple": { "limit": 10, "period": 60 } },
      { "name": "SOCKET_LIMIT", "namespace_id": "9512", "simple": { "limit": 30, "period": 60 } },
      { "name": "INFO_LIMIT", "namespace_id": "9513", "simple": { "limit": 60, "period": 60 } },
    ],
  },
}
