{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chess Nines ruleset lock",
  "description": "Every resolved value of one version of a Candidate or Official ruleset (S45), or of an archived version whose games and reports must replay as played (S68). A test fails when a current ruleset stops resolving to these values.",
  "type": "object",
  "required": ["id", "version", "values"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "notes": { "type": "string" },
    "values": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "type": "null" },
          { "type": "string" },
          { "type": "number" },
          { "type": "boolean" },
          { "type": "array", "items": { "type": ["string", "number", "boolean"] } }
        ]
      }
    }
  },
  "additionalProperties": false
}
