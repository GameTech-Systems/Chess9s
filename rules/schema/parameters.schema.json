{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chess Nines parameter registry",
  "type": "object",
  "required": ["version", "parameters"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string" },
    "parameters": {
      "type": "array",
      "items": { "$ref": "#/$defs/parameter" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "parameter": {
      "type": "object",
      "required": ["id", "label", "piece", "players", "type", "default", "options", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9]+(\\.[a-zA-Z0-9]+)+$" },
        "label": { "type": "string" },
        "description": { "type": "string" },
        "piece": { "type": ["string", "null"] },
        "players": {
          "type": "array",
          "items": { "enum": [2, 3] },
          "minItems": 1,
          "uniqueItems": true
        },
        "type": { "enum": ["integer", "boolean", "enum", "enumSet"] },
        "default": {},
        "options": { "type": "array", "minItems": 1 },
        "group": {
          "enum": [
            "King",
            "Queen",
            "Pawns",
            "Center",
            "Coast",
            "Dragon Tail",
            "Dragon Heads",
            "Sun and Moon",
            "Turns and draws",
            "Setup"
          ]
        },
        "optionLabels": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "status": { "enum": ["proposed", "experimental", "candidate", "official", "deprecated"] },
        "affects": { "type": "array", "items": { "type": "string" } },
        "needsDecision": { "type": "boolean" },
        "source": { "type": "string" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
